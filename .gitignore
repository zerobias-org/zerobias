# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo
*~

# Local environment overrides
.env
.env.local

# Personal .npmrc (with real tokens). The committed file is .npmrc.example.
.npmrc

# Local-only Claude Code settings (per-developer)
.claude/settings.local.json

# Logs from helper scripts
*.log

# Node (in case anything top-level uses it)
node_modules/

# Sub-repo clones managed by scripts/clone-all.sh.
# Each sub-repo lives at the root and is its own git clone — never tracked here.
# We allow-list the meta-repo's own root directories.
/*/
!/.claude/
!/.github/
!/docs/
!/scripts/
!/artifact-map/
