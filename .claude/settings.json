{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git submodule status:*)",
      "Bash(git submodule foreach:*)",
      "Bash(./scripts/update_all.sh:*)",
      "Bash(./scripts/add_repos.sh:*)",
      "Bash(./scripts/clone-all.sh:*)",
      "Bash(./scripts/sync-skills.sh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync-skills.sh --quiet",
            "timeout": 30,
            "statusMessage": "Syncing sub-repo skills"
          }
        ]
      }
    ]
  }
}
